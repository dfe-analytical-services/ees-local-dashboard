# Copy this file to `.env` and adjust. Anything set in the real environment
# takes precedence over values in `.env`.

# The explore-education-statistics checkout whose services the dashboard
# manages. If unset, defaults to a sibling `explore-education-statistics`
# checkout next to this repository. On Windows, both native paths
# (`C:/Users/...`) and Git Bash-style paths (`/c/Users/...`) work.
EES_PROJECT_ROOT=/path/to/explore-education-statistics

# The port the dashboard runs on (default 4300).
# DASHBOARD_PORT=4300
